# Password for the app. Required.
APP_PASSWORD=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Where the React app runs (CORS)
FRONTEND_URL=http://localhost:5173

# Language model: groq, openai or ollama (all spoken to through the OpenAI-compatible API)
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides; each provider has a default
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=

# Retrieval confidence: below MIN_SIMILARITY DocuChat says the document doesn't cover it
MIN_SIMILARITY=0.55
HIGH_SIMILARITY=0.7
TOP_K=4

# SQLite + uploaded PDFs + Chroma live here
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/docuchat
